#!/usr/bin/env sh

set -eu

DIRNAME=$(cd "$(dirname "$0")" && pwd)
LOCAL_GRADLE="$DIRNAME/.gradle84-temp/gradle-8.4/bin/gradle"

if [ -x "$LOCAL_GRADLE" ]; then
  exec "$LOCAL_GRADLE" "$@"
fi

WRAPPER_DIR="$DIRNAME/gradle/wrapper"

if [ ! -d "$WRAPPER_DIR" ]; then
  echo "Gradle wrapper directory not found: $WRAPPER_DIR"
  echo "You can generate it by running 'gradle wrapper' with a local Gradle installation."
  exit 1
fi

exec java -cp "$WRAPPER_DIR/*" org.gradle.wrapper.GradleWrapperMain "$@"
